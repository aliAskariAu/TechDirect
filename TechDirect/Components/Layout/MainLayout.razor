@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Routing
@using TechDirect.Components.Account.Shared
@using TechDirect.Services
@using TechDirect.Components.Layout

@inject AuthenticationStateProvider AuthenticationStateProvider

<div class="d-flex flex-column min-vh-100">
    <header>
        <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom shadow-sm custom-nav py-3">
            <div class="container-fluid">
                <a class="navbar-brand fw-bold ps-5" href="/">TechDirect</a>

                <button class="navbar-toggler" type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar"
                        aria-expanded="false"
                        aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNavbar">
                    <!-- Centre menu -->
                    <ul class="navbar-nav mx-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <NavLink class="nav-link" href="/" Match="NavLinkMatch.All">Home</NavLink>
                        </li>
                        <li class="nav-item">
                            <NavLink class="nav-link" href="/deal">Deals</NavLink>
                        </li>
                        <li class="nav-item">
                            <NavLink class="nav-link" href="/products">Products</NavLink>
                        </li>
                        <li class="nav-item">
                            <NavLink class="nav-link" href="/contactus">Contact Us</NavLink>
                        </li>
                    </ul>

                    <!-- Right side – login / account / cart -->
                    <AuthorizeView>
                        <Authorized>
                            <ul class="navbar-nav ms-auto align-items-center">
                                <li class="nav-item">
                                    <span class="nav-link disabled p-0 me-2"
                                          style="cursor: default; color: darkblue">
                                        Hello @(string.IsNullOrEmpty(displayName) ? "there" : displayName)
                                    </span>
                                </li>

                                @{
                                    var user = context.User;
                                    var isAdmin = user.IsInRole("Admin");
                                }

                                <li class="nav-item ms-2">
                                    @if (isAdmin)
                                    {
                                        <NavLink class="nav-link" href="/admin">Account</NavLink>
                                    }
                                    else
                                    {
                                        <NavLink class="nav-link" href="/Account/Manage">Account</NavLink>
                                    }
                                </li>

                                <li class="nav-item ms-2">
                                    <NavLink class="nav-link" href="/logout">Logout</NavLink>
                                </li>

                                <li class="nav-item ms-3 pe-4">
                                    <CartIcon />
                                </li>
                            </ul>
                        </Authorized>

                        <NotAuthorized>
                            <ul class="navbar-nav ms-auto align-items-center">
                                <li class="nav-item">
                                    <NavLink class="nav-link" href="/login">Login</NavLink>
                                </li>
                                <li class="nav-item ms-2">
                                    <NavLink class="nav-link" href="/register">Register</NavLink>
                                </li>
                                <li class="nav-item ms-3 pe-4">
                                    <CartIcon />
                                </li>
                            </ul>
                        </NotAuthorized>
                    </AuthorizeView>
                </div>

            </div>
        </nav>
    </header>

    <main class="flex-fill">
        <div class="container py-4">
            @Body
        </div>
    </main>

    <footer class="bg-dark text-light py-3 mt-auto">
        <div class="container text-center">
            © 2025 TechDirect •
            <a href="#" class="text-decoration-none text-light">Privacy</a> •
            <a href="#" class="text-decoration-none text-light">Terms</a>
        </div>
    </footer>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
        crossorigin="anonymous"></script>

<script>
    window.initCarousels = () => {
        if (!window.bootstrap || !window.bootstrap.Carousel) {
            return;
        }

        const hero = document.getElementById('homeHeroCarousel');
        if (hero) {
            bootstrap.Carousel.getOrCreateInstance(hero, {
                interval: 5000,
                ride: 'carousel',
                pause: false
            });
        }

        const specials = document.getElementById('specialsCarousel');
        if (specials) {
            bootstrap.Carousel.getOrCreateInstance(specials, {
                interval: 5000,
                ride: 'carousel',
                pause: false
            });
        }
    };
</script>

@code {
    private string? displayName;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity?.IsAuthenticated == true)
        {
            var first = user.FindFirst("given_name")?.Value;
            var last = user.FindFirst("family_name")?.Value;

            if (!string.IsNullOrWhiteSpace(first) && !string.IsNullOrWhiteSpace(last))
            {
                displayName = $"{first} {last}";
            }
            else if (!string.IsNullOrWhiteSpace(first))
            {
                displayName = first;
            }
            else
            {
                displayName = "there";
            }
        }
        else
        {
            displayName = "there";
        }
    }
}
