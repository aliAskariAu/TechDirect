@page "/contactus"
@rendermode InteractiveServer

@layout MainLayout

@using System.ComponentModel.DataAnnotations
@using TechDirect.Components.Layout
@using TechDirect.Services
@inject MailKitEmailSender EmailSender
@inject IConfiguration Config

<h2>Contact us</h2>
<p class="text-muted">
    Have a question about an order or a product? Send us a message.
</p>

@if (!string.IsNullOrEmpty(successMessage))
{
    <div class="alert alert-success">@successMessage</div>
}

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger">@errorMessage</div>
}

<EditForm Model="contactModel" OnValidSubmit="HandleValidSubmit">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="mb-3">
        <label class="form-label">Your name</label>
        <InputText class="form-control" @bind-Value="contactModel.Name" />
        <ValidationMessage For="@(() => contactModel.Name)" />
    </div>

    <div class="mb-3">
        <label class="form-label">Your email</label>
        <InputText class="form-control" @bind-Value="contactModel.Email" />
        <ValidationMessage For="@(() => contactModel.Email)" />
    </div>

    <div class="mb-3">
        <label class="form-label">Subject</label>
        <InputText class="form-control" @bind-Value="contactModel.Subject" />
        <ValidationMessage For="@(() => contactModel.Subject)" />
    </div>

    <div class="mb-3">
        <label class="form-label">Message</label>
        <InputTextArea class="form-control"
                       @bind-Value="contactModel.Message"
                       rows="5" />
        <ValidationMessage For="@(() => contactModel.Message)" />
    </div>

    <button class="btn btn-primary" disabled="@(isSending)">
        @(isSending ? "Sending..." : "Send message")
    </button>
</EditForm>

@code {
    private ContactFormModel contactModel = new();
    private bool isSending;
    private string? successMessage;
    private string? errorMessage;

    private async Task HandleValidSubmit()
    {
        successMessage = null;
        errorMessage = null;
        isSending = true;

        try
        {
            // Read recipients for the contact form from configuration
            // appsettings.json:
            // "ContactForm": { "Recipients": "support@yourdomain.com, other@yourdomain.com" }
            var recipientsConfig = Config["ContactForm:Recipients"];

            if (string.IsNullOrWhiteSpace(recipientsConfig))
            {
                // Fallback in development so the message goes somewhere
                recipientsConfig = contactModel.Email;
            }

            // Support one or more recipients, separated by comma or semicolon
            var recipients = recipientsConfig
                .Split(new[] { ',', ';' }, StringSplitOptions.RemoveEmptyEntries)
                .Select(r => r.Trim())
                .ToList();

            var subject = $"Contact form: {contactModel.Subject}";

            var messageHtml = System.Net.WebUtility
                .HtmlEncode(contactModel.Message)
                .Replace("\r\n", "<br />")
                .Replace("\n", "<br />");

            var body = $@"
<h2>New contact form message</h2>
<p><strong>Name:</strong> {contactModel.Name}</p>
<p><strong>Email:</strong> {contactModel.Email}</p>
<p><strong>Subject:</strong> {contactModel.Subject}</p>
<p><strong>Message:</strong></p>
<p>{messageHtml}</p>";

            // Send to each configured recipient
            foreach (var recipient in recipients)
            {
                await EmailSender.SendEmailAsync(recipient, subject, body);
            }

            successMessage = "Your message has been sent. We will get back to you soon.";
            contactModel = new ContactFormModel(); // reset form
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Contact form email failed: {ex.Message}");
            errorMessage = "Sorry, there was a problem sending your message. Please try again later.";
        }
        finally
        {
            isSending = false;
        }
    }

    public class ContactFormModel
    {
        [Required(ErrorMessage = "Please enter your name.")]
        public string Name { get; set; } = string.Empty;

        [Required(ErrorMessage = "Please enter your email.")]
        [EmailAddress(ErrorMessage = "Please enter a valid email address.")]
        public string Email { get; set; } = string.Empty;

        [Required(ErrorMessage = "Please enter a subject.")]
        public string Subject { get; set; } = string.Empty;

        [Required(ErrorMessage = "Please enter a message.")]
        public string Message { get; set; } = string.Empty;
    }
}
