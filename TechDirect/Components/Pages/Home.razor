@page "/"

<div class="home-hero text-center mb-5">
    <h1 class="display-5 fw-bold text-white mb-3">Upgrade Your Tech</h1>
    <p class="lead text-white-50 mb-4">
        Discover the latest gadgets designed for performance and style.
    </p>
    <button class="btn btn-primary btn-lg px-4">
        Shop Now
    </button>
</div>

<section>
    <h2 class="h4 mb-4">Featured Products</h2>

    <div class="row g-4">
        @foreach (var product in FeaturedProducts)
        {
            <div class="col-12 col-sm-6 col-md-4 col-lg-3">
                <div class="card h-100 shadow-sm">
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title">@product.Name</h5>
                        <p class="card-text fw-bold mb-3">@product.Price.ToString("C")</p>
                        <button class="btn btn-primary mt-auto">Add to Cart</button>
                    </div>
                </div>
            </div>
        }
    </div>
</section>

@code {
    private readonly List<(string Name, decimal Price)> FeaturedProducts = new()
    {
        ("SmartDevice 1", 499m),
        ("SmartDevice 2", 649m),
        ("SmartDevice 3", 799m),
        ("SmartDevice 4", 949m),
        ("SmartDevice 5", 1099m),
        ("SmartDevice 6", 1249m),
        ("SmartDevice 7", 1399m),
        ("SmartDevice 8", 1549m),
    };
}
