@page "/"
@rendermode InteractiveServer
@layout MainLayout

@using TechDirect.Components.Layout
@using TechDirect.Data
@using Microsoft.EntityFrameworkCore
@inject ApplicationDbContext Db
@using Microsoft.JSInterop
@using TechDirect.Services
@inject IJSRuntime JS
@inject CartService Cart
@inject NavigationManager Nav

<div class="container mt-4">

    <!-- HERO SLIDESHOW -->
    <div id="homeHeroCarousel" class="carousel slide mb-5" data-bs-ride="carousel">
        <div class="carousel-indicators">
            <button type="button" data-bs-target="#homeHeroCarousel" data-bs-slide-to="0" class="active" aria-current="true" aria-label="Slide 1"></button>
            <button type="button" data-bs-target="#homeHeroCarousel" data-bs-slide-to="1" aria-label="Slide 2"></button>
            <button type="button" data-bs-target="#homeHeroCarousel" data-bs-slide-to="2" aria-label="Slide 3"></button>
            <button type="button" data-bs-target="#homeHeroCarousel" data-bs-slide-to="3" aria-label="Slide 4"></button>
        </div>

        <div class="carousel-inner">

            <div class="carousel-item active">
                <img src="/images/banners/slide1.jpg" class="d-block w-100" alt="Latest tech deals">
                <div class="carousel-caption d-none d-md-block text-start">
                    <h2>Latest tech deals</h2>
                    <p>Upgrade your setup with our newest arrivals.</p>
                    <a href="/products" class="btn btn-primary">
                        Shop now
                    </a>
                </div>
            </div>

            <div class="carousel-item">
                <img src="/images/banners/slide2.jpg" class="d-block w-100" alt="Accessories">
                <div class="carousel-caption d-none d-md-block text-start">
                    <h2>Accessories you will use daily</h2>
                    <p>Find keyboards, mice and more.</p>
                    <a href="/products" class="btn btn-primary">
                        Shop now
                    </a>
                </div>
            </div>

            <div class="carousel-item">
                <img src="/images/banners/slide3.jpg" class="d-block w-100" alt="Special offers">
                <div class="carousel-caption d-none d-md-block text-start">
                    <h2>Special offers this week</h2>
                    <p>Limited time discounts on selected products.</p>
                    <a href="/products" class="btn btn-primary">
                        Shop now
                    </a>
                </div>
            </div>

            <div class="carousel-item">
                <img src="/images/banners/slide4.jpg" class="d-block w-100" alt="Special offers">
                <div class="carousel-caption d-none d-md-block text-start">
                    <h2>Special offers this week</h2>
                    <p>Limited time discounts on selected products.</p>
                    <a href="/products" class="btn btn-primary">
                        Shop now
                    </a>
                </div>
            </div>

        </div>

        <button class="carousel-control-prev" type="button" data-bs-target="#homeHeroCarousel" data-bs-slide="prev">
            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Previous</span>
        </button>
        <button class="carousel-control-next" type="button" data-bs-target="#homeHeroCarousel" data-bs-slide="next">
            <span class="carousel-control-next-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Next</span>
        </button>
    </div>

    <!-- LATEST PRODUCTS GRID -->
    <section class="mb-5">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h3 class="mb-0">Latest products</h3>
            <NavLink href="/products" class="btn btn-link">
                View all
            </NavLink>
        </div>

        @if (latestProducts == null || latestProducts.Count == 0)
        {
            <p class="text-muted">No products available yet.</p>
        }
        else
        {
            <div class="row g-3">
                @foreach (var p in latestProducts)
                {
                    <div class="col-6 col-md-3">
                        <div class="card h-100">
                            @if (!string.IsNullOrEmpty(p.ImageUrl))
                            {
                                <img src="@p.ImageUrl" class="card-img-top" alt="@p.Name" style="object-fit: contain; height: 160px;">
                            }
                            else
                            {
                                <div class="d-flex align-items-center justify-content-center bg-light" style="height: 160px;">
                                    <span class="text-muted">No image</span>
                                </div>
                            }

                            <div class="card-body d-flex flex-column">
                                <h6 class="card-title text-truncate">@p.Name</h6>

                                @if (p.DiscountPrice != null && p.DiscountPrice < p.Price)
                                {
                                    <p class="mb-2">
                                        <span class="text-muted text-decoration-line-through me-2">
                                            @p.Price.ToString("C")
                                        </span>
                                        <span class="fw-bold text-danger">
                                            @p.DiscountPrice?.ToString("C")
                                        </span>
                                    </p>
                                }
                                else
                                {
                                    <p class="card-text fw-bold mb-2">@p.Price.ToString("C")</p>
                                }

                                <div class="mt-auto">
                                    <button class="btn btn-sm btn-primary w-100"
                                            @onclick="() => AddToCart(p)">
                                        Add to cart
                                    </button>
                                </div>
                            </div>

                        </div>
                    </div>
                }
            </div>
        }
    </section>

    <!-- SPECIAL DEALS MULTI ITEM CAROUSEL -->
    <section class="mb-5">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h3 class="mb-0">Special Deals</h3>
        </div>

        @if (specialDeals == null || specialDeals.Count == 0)
        {
            <p class="text-muted">No special deals at the moment.</p>
        }
        else
        {
            <div id="specialsCarousel" class="carousel slide" data-bs-ride="carousel" data-bs-interval="5000">
                <div class="carousel-inner">

                    @for (var i = 0; i < specialDeals.Count; i += 4)
                    {
                        var isActive = i == 0;
                        <div class="carousel-item @(isActive ? "active" : "")">
                            <div class="row g-3">
                                @foreach (var p in specialDeals.Skip(i).Take(4))
                                {
                                    <div class="col-6 col-md-3">
                                        <div class="card h-100 position-relative">

                                            <!-- SALE badge -->
                                            @if (p.IsOnDeal)
                                            {
                                                <span class="badge bg-danger position-absolute"
                                                      style="top: 8px; left: 8px;">
                                                    Sale
                                                </span>
                                            }

                                            <!-- Product image -->
                                            @if (!string.IsNullOrEmpty(p.ImageUrl))
                                            {
                                                <img src="@p.ImageUrl"
                                                     class="card-img-top"
                                                     alt="@p.Name"
                                                     style="object-fit: contain; height: 140px;">
                                            }
                                            else
                                            {
                                                <div class="d-flex align-items-center justify-content-center bg-light"
                                                     style="height: 140px;">
                                                    <span class="text-muted">No image</span>
                                                </div>
                                            }

                                            <div class="card-body d-flex flex-column">
                                                <h6 class="card-title text-truncate">@p.Name</h6>

                                                @if (p.IsOnDeal)
                                                {
                                                    <p class="mb-1">
                                                        <span class="text-muted text-decoration-line-through me-2">
                                                            @p.Price.ToString("C")
                                                        </span>
                                                        <span class="fw-bold text-danger">
                                                            @p.DiscountPrice?.ToString("C")
                                                        </span>
                                                    </p>
                                                }
                                                else
                                                {
                                                    <p class="fw-bold mb-2">@p.Price.ToString("C")</p>
                                                }

                                                <div class="mt-auto">
                                                    <button class="btn btn-sm btn-outline-primary w-100"
                                                            @onclick="() => AddToCart(p)">
                                                        Add to cart
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>

                <button class="carousel-control-prev" type="button" data-bs-target="#specialsCarousel" data-bs-slide="prev">
                    <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                    <span class="visually-hidden">Previous</span>
                </button>
                <button class="carousel-control-next" type="button" data-bs-target="#specialsCarousel" data-bs-slide="next">
                    <span class="carousel-control-next-icon" aria-hidden="true"></span>
                    <span class="visually-hidden">Next</span>
                </button>
            </div>
        }
    </section>


</div>

@code {
    private List<Product> latestProducts = new();
    private List<Product> specialDeals = new();

    protected override async Task OnInitializedAsync()
    {
        // Latest Products in home page
        latestProducts = await Db.Products
            .OrderByDescending(p => p.CreatedAt)
            .Take(8)
            .ToListAsync();

        
        // Only discounted products in home page
        specialDeals = await Db.Products
            .Where(p => p.DiscountPrice != null && p.DiscountPrice < p.Price)
            .OrderByDescending(p => p.CreatedAt)
            .Take(12)
            .ToListAsync();
            
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await JS.InvokeVoidAsync("initCarousels");
    }

    private void AddToCart(Product p)
    {
        Cart.AddItem(p);
        Nav.NavigateTo("/cart");
    }
}
