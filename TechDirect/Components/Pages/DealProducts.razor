@page "/deal"
@rendermode InteractiveServer

@layout MainLayout

@using TechDirect.Components.Layout
@using TechDirect.Data
@using Microsoft.EntityFrameworkCore
@using TechDirect.Services
@inject ApplicationDbContext Db
@inject CartService Cart
@inject NavigationManager Nav

<h2>Special Deals</h2>
<p class="text-muted">Discounted products currently on sale.</p>

@if (dealProducts == null)
{
    <p>Loading deals...</p>
}
else if (dealProducts.Count == 0)
{
    <p>No deals at the moment. Please check back later.</p>
}
else
{
    <div class="row g-3">
        @foreach (var p in dealProducts)
        {
            <div class="col-6 col-md-3">
                <div class="card h-100">
                    @if (!string.IsNullOrEmpty(p.ImageUrl))
                    {
                        <img src="@p.ImageUrl" class="card-img-top" alt="@p.Name"
                             style="object-fit: contain; height: 160px;">
                    }
                    else
                    {
                        <div class="d-flex align-items-center justify-content-center bg-light"
                             style="height: 160px;">
                            <span class="text-muted">No image</span>
                        </div>
                    }

                    <div class="card-body d-flex flex-column">
                        <h6 class="card-title text-truncate">@p.Name</h6>

                        @if (p.IsOnDeal)
                        {
                            <p class="mb-1">
                                <span class="text-muted text-decoration-line-through me-2">
                                    @p.Price.ToString("C")
                                </span>
                                <span class="fw-bold text-danger">
                                    @p.DiscountPrice?.ToString("C")
                                </span>
                            </p>
                        }
                        else
                        {
                            <p class="fw-bold">@p.Price.ToString("C")</p>
                        }

                        <div class="mt-auto">
                            <button class="btn btn-sm btn-primary w-100"
                                    @onclick="() => AddToCart(p)">
                                Add to cart
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

@code {
    private List<Product> dealProducts = new();

    protected override async Task OnInitializedAsync()
    {
        dealProducts = await Db.Products
            .Where(p => p.DiscountPrice != null && p.DiscountPrice < p.Price)
            .OrderByDescending(p => p.CreatedAt)
            .ToListAsync();
    }

    private void AddToCart(Product p)
    {
        Cart.AddItem(p);
        Nav.NavigateTo("/cart");
    }
}
